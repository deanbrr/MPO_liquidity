- ex = {"level": {"value": [1.0, 0.0, -1.0, -2.0], "unit": "exit factor level by exit window", "rationale": "Exit factor X: open +1, normal 0, drought -1, frozen -2.", "source": "SYN section 4.1 [A]"}, "start": {"value": -1.0, "unit": "level", "rationale": "Drought today.", "source": "SYN section 4.1"}, "phi_q": {"value": 0.6, "unit": "AR(1) per quarter", "rationale": "Persistence of the exit factor around its window level.", "source": "SYN section 4.1 [A]"}, "sigma_q": {"value": 0.25, "unit": "quarterly shock sd", "rationale": "Noise in exit activity.", "source": "[A]"}}
- vix = {"level": {"value": [15.0, 19.0, 34.0, 22.0], "unit": "VIX points by regime", "rationale": "Implied-volatility level by regime (RV-20 adds implied vol as a driver).", "source": "SYN section 4.6; DSGO RV-20 [A]"}, "start": {"value": 16.0, "unit": "VIX points", "rationale": "Calm market today (F_t = 0.10).", "source": "SYN section 4.1"}, "kappa_q": {"value": 0.5, "unit": "per quarter", "rationale": "Mean reversion to the regime level.", "source": "[A]"}, "spot_down": {"value": -0.5, "unit": "VIX points per 1% fall in the quarter's equity return", "rationale": "Spot-vol response (quarterly analogue of s- = -1.35 daily).", "source": "SYN section 4.6 [A]"}, "spot_up": {"value": -0.15, "unit": "VIX points per 1% rise", "rationale": "Weaker response to rallies.", "source": "SYN section 4.6 [A]"}, "sigma_q": {"value": 2.5, "unit": "VIX points", "rationale": "Idiosyncratic VIX noise.", "source": "[A]"}, "floor": {"value": 9.0, "unit": "VIX points", "rationale": "Lower bound.", "source": "[A]"}}
- corr_normal = [[1.0, -0.55, 0.15, 0.25, 0.45], [-0.55, 1.0, -0.1, -0.2, -0.4], [0.15, -0.1, 1.0, 0.15, 0.05], [0.25, -0.2, 0.15, 1.0, 0.15], [0.45, -0.4, 0.05, 0.15, 1.0]]  [correlation of shocks [equity, spread, yield, oil, exit] outside crisis]
    rationale: Spreads widen and exits shut when equities fall.
    source: SYN section 4.1 [A]
- corr_crisis = [[1.0, -0.7, -0.3, 0.45, 0.55], [-0.7, 1.0, 0.2, -0.35, -0.55], [-0.3, 0.2, 1.0, -0.1, -0.15], [0.45, -0.35, -0.1, 1.0, 0.3], [0.55, -0.55, -0.15, 0.3, 1.0]]  [correlation of shocks in crisis quarters]
    rationale: Correlations rise in a crisis; yields fall with equities (flight to quality); oil falls with equities (demand bust).
    source: SYN section 4.1 (R_s blend) [A]
============================== tree
- str_draw_threshold = 0.08  [draw rate]
    rationale: A glut or demand-bust node is STR when next year's draw is at least 8%.
    source: DSGO section 1.1 node classes
- n_factor_mean_paths = 20000  [paths]
    rationale: Paths used to compute the 5-year average expected factor returns that translate beliefs into alphas.
    source: [I]
- branches = [10, 7]  [children at t = 0 and t = 1]
    rationale: Rank rule (children >= matched drivers + 1): 10 children match 7 drivers at stage 1 (6 factors + belief error), 7 children match 6 factors at stage 2. DSGO's 10 x 8 x 8 = 640 leaves does not fit the 15-minute budget; the computed task asks for about 200 leaves.
    source: DSGO section 5.2 rank rule (RV-06); computed task (about 200 leaves)
- fan_paths = 3  [3-year fan paths per stage-2 node]
    rationale: One medoid path per tercile of the status-quo 3-year return, moment-matched on that return: 10 x 7 x 3 = 210 leaves.
    source: DSGO section 5.2 (octiles scaled to terciles) [A]
- n_stage1_paths = 20000  [paths]
    rationale: One-year paths simulated from today for the stage-1 clustering.
    source: DSGO section 5.2
- n_stage2_paths = 2000  [paths per stage-1 node]
    rationale: Continuations clustered into the stage-2 children.
    source: DSGO section 5.2
- n_fan_candidates = 300  [paths per stage-2 node]
    rationale: Three-year candidate paths from which the tercile medoids are chosen.
    source: [A]
- stage1_strata = {"STR_DB": 1, "STR_other": 1, "DRT_GW": 2, "DRT": 3, "BEN": 3}  [branches per stratum]
    rationale: Stage 1 is stratified by shock type: at least one demand-bust STR branch, one other STR branch and a Gulf-war continuation, because the three call on liquidity differently. Strata with too few paths merge into a neighbour.
    source: DSGO section 5.1 start-state stratification; SYN L3
- min_stratum_paths = 40  [paths]
    rationale: A stratum with fewer simulated paths than this (or than its branch count) is merged into its neighbour.
    source: [A]
- stage2_min_class_mass = 0.03  [probability]
    rationale: A node class with at least this conditional mass gets its own stage-2 branch; paths of rarer classes join the nearest cluster, so no probability mass is dropped.
    source: [A]
- seed = 11  [seed]
    rationale: Tree seed (deterministic).
    source: [A]
- belief_error_fan_scale = 1.6666666667  [multiplier on sigma_post x e in each fan year]
    rationale: The belief-error driver is drawn at the fan branching (so no decision node can condition on it) and acts in the three fan years; scaling by 5/3 gives it the 5-year log-wealth impact of a 5-year alpha error. Drawn at stage 1 (DSGO section 3.3) it was a look-ahead leak: stage-1 decisions traded on it in the tree while the executed playbook could not see it.
    source: DSGO section 3.3 (RV-01), implementation deviation [I]
- stage2_recourse_only = true  [flag]
    rationale: With three fan paths per stage-2 node, discretionary stage-2 trades are fitted to three outcomes; stage-2 nodes keep funding moves, forced deleveraging and the stage-1 pacing and overlay (like the fans). Year-1 contingent plans (stage 1) remain fully discretionary.
    source: DSGO sections 5.2-5.3 deviation, measured in the out-of-sample diagnostics [I]
============================== simulation
- n_cert = 10000  [paths]
    rationale: Fresh certification paths (pooled worlds), common random numbers across policies.
    source: computed task; DSGO section 5.5
- n_select = 4000  [paths]
    rationale: Selection paths (choose the best simple rule) on their own seed.
    source: DSGO section 4.3
- chunk = 1250  [paths]
    rationale: Paths per certification batch (one batch per worker; 10,000 paths = 8 batches run in parallel).
    source: [A]
- idio = true  [flag]
    rationale: Idiosyncratic outcome noise per holding in the simulator (sigma_idio of the segment), absent from the tree.
    source: DSGO section 3.3
- n_replication_paths = 4000  [paths]
    rationale: Paths per replication / placebo book.
    source: [A scaled]
============================== frontier
- eps_grid = [0.003, 0.006, 0.012, 0.025, 0.05, 1.0]  [tree red-event CVaR share (1.0 = unbounded)]
    rationale: At least five points of max P(goal) and min bPOE against the red-event limit.
    source: computed task; DSGO section 4.8
- milp_points = [0.003, 1.0]  [red-event CVaR shares]
    rationale: Frontier points that also run the max-P(goal) comparison (the 0.6% point is the main MILP); the remaining points reuse it when their GBO solution is identical.
    source: [A]
- delta_grid = [0.01, 0.02, 0.04]  [share of W0]
    rationale: Depth-guard frontier points beyond delta = 0 (GBO only).
    source: DSGO section 4.8
