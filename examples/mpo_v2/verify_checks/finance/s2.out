TOP KEYS: ['_meta', 'rates', 'goal', 'worlds', 'regimes', 'factors', 'owner_draw', 'private_engine', 'tree', 'seeds', 'treasury', 'overlay', 'corporate_finance', 'templates', 'pacing', 'trading', 'constraints', 'valuation', 'objective', 'solver', 'simulation', 'baselines', 'frontier', 'report', 'bids', 'fusion', 'truth_model', 'book']
_meta:
  label = 'SYNTHETIC - NOT ADIC DATA. Illustrative parameters for the slimmed five-component prototype. Not ADIC data and not a forecast.'
  spec = 'design/DECISION_SPACE_AND_GOAL_OBJECTIVE.md v1.1 (DSGO), as revised by examples/mpo_v2/spec_review.md; design/SLIM_ARCHITECTURE.md (SLIM)'
  version = 'mpo_v2 prototype 1.0, 2026-10-19'
  how_to_change = "Every number the program uses is a 'value' in this file. Edit and re-run mpo_v2.py. The run lists any parameter the code never read (results.json checks.params_unused) and any entry missing a unit, rationale or source."
  units = 'Money in $bn; rates and returns are annual decimals unless the key ends in _q (quarterly) or _pp (percentage points a year).'
  source_tags = 'SYN = research/00_SYNTHESIS.md; GRP = research/groups/01_GROUPS_SYNTHESIS.md; RA = research/groups/02_REAL_ASSETS_SYNTHESIS.md; LIT = research/literature/00_LITERATURE_SYNTHESIS.md; ARCH = design/ARCHITECTURE.md; DSGO = design/DECISION_SPACE_AND_GOAL_OBJECTIVE.md; TD = examples/tree_demo; [A] = wor
